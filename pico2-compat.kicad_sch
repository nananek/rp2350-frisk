  (text "Pico 2 header: pin 1 = GP0 at the native-USB end; 2.54 mm pitch, 17.78 mm row spacing." (at 30 40 0) (effects (font (size 1.5 1.5))))
  (text "UART0: GP0 (TX, pin 1) -> CH343P RXD (pin 5); CH343P TXD (pin 4) -> GP1 (RX, pin 2)." (at 30 47 0) (effects (font (size 1.5 1.5))))
  (text "PIO USB: GP12 (pin 16) = D+, GP13 (pin 17) = D-, 22 ohm series, 1.5k D+ pull-up (device only)." (at 30 54 0) (effects (font (size 1.5 1.5))))
  (text "Native USB: RP2350 USB_DP/USB_DM, 27 ohm series, USBLC6 ESD." (at 30 61 0) (effects (font (size 1.5 1.5))))
  (text "Power: each Type-C VBUS is diode-ORed to VSYS; AP2112K-3.3 makes 3V3." (at 30 68 0) (effects (font (size 1.5 1.5))))
  (text "BOOT: QSPI_SS --1k--> button --> GND. RUN: RUN --1k--> button --> GND." (at 30 75 0) (effects (font (size 1.5 1.5))))
